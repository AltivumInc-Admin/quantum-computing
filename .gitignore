# SAM build artifacts
lambda/tutor/.aws-sam/

# sam deploy --guided writes every parameter the operator types (including
# deployed-configuration values that must never reach this PUBLIC repo) into
# samconfig files verbatim as parameter_overrides. Never commit one, at any
# depth. Guarded by web/__tests__/infra/no-commercial-terms.test.ts.
samconfig.toml
samconfig.*.toml
samconfig.yaml
samconfig.*.yaml
samconfig.yml
samconfig.*.yml

# Generated web copy of the shared tutor logic (scripts/gen-tutor-core.mjs);
# regenerated by the web pretest/prebuild hooks from lambda/tutor/tutor-core.mjs.
web/src/lib/tutor-core.generated.ts
web/src/lib/tutor-billing.generated.ts

# Job entry-point scripts + outputs generated by 06-hybrid-jobs notebooks when run locally
06-hybrid-jobs/notebooks/first_job_entry.py
06-hybrid-jobs/notebooks/vqe_monitored_job.py
06-hybrid-jobs/notebooks/results.json
06-hybrid-jobs/notebooks/qml_job_src/
lambda/sync/.aws-sam/

# Review-email Lambda: node_modules + build artifacts (npm ci restores them
# from the committed package-lock.json; see lambda/review-email/README.md).
lambda/review-email/node_modules/
lambda/review-email/.aws-sam/

# QPU-submit Lambda: node_modules + build artifacts (npm ci restores them
# from the committed package-lock.json; see lambda/qpu/README.md).
lambda/qpu/node_modules/
lambda/qpu/.aws-sam/

# design-sync staging / build output (machine state; not committed)
/.ds-sync/
/ds-bundle/
/.design-sync/.cache/
/.design-sync/learnings/
/.design-sync/node_modules

# Cached CloudFront access logs pulled by scripts/analytics/backfill.mjs.
# Raw logs carry visitor IP addresses and must never be committed.
.analytics-cache/

# Per-developer AI-assistant state. These directories are populated by whichever
# assistant the developer happens to run (skills, local settings, lockfiles);
# nothing in the project reads them, and .claude/ carries settings.local.json.
/.agents/
/.claude/
/.continue/
/.factory/
/.kiro/
/skills-lock.json

# Braket job output artifacts, written next to whatever invoked them.
/results.json

# Design-system handoff archives. The design system is the claude.ai project
# and .design-sync/; a zip in the repo root is a stale copy of a moving target
# (this one was the July "Instrument" era, superseded twice by 2026-08-31).
/*.zip

{
  "name": "quantum-tutor",
  "version": "1.0.0",
  "description": "Streaming Anthropic-backed lesson tutor for the quantum curriculum (Ask the margin)",
  "type": "module",
  "private": true,
  "main": "index.mjs",
  "files": [
    "index.mjs",
    "tutor-core.mjs",
    "tutor-billing.mjs",
    "corpus.json"
  ],
  "scripts": {
    "test": "node --test",
    "build:corpus": "node ../../scripts/build_tutor_corpus.mjs",
    "predeploy": "npm run build:corpus && node deploy-check.mjs",
    "deploy": "npm run build:corpus && node deploy-check.mjs && sam build && sam deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@aws-sdk/client-dynamodb": "^3.1095.0",
    "@aws-sdk/client-secrets-manager": "^3.600.0",
    "aws-jwt-verify": "^5.2.1"
  }
}
